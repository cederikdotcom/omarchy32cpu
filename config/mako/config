# Omarchy 32-bit Lite notification daemon defaults.
#
# mako 1.10 has no include directive, so theming replaces this file whole:
# omarchy-theme-set renders default/themed/mako.ini.tpl to
# ~/.local/state/omarchy/current/theme/mako.ini and omarchy-theme-set-mako
# symlinks ~/.config/mako/config to it. This copy only serves before the
# first theme-set; keep it plain.

font=monospace 11
width=420
height=110
margin=10
padding=10
border-size=2
border-radius=0
max-icon-size=32
default-timeout=5000
anchor=top-right

background-color=#121212
text-color=#d0d0d0
border-color=#7aa2f7
progress-color=over #33467c

[urgency=low]
text-color=#707070

[urgency=critical]
border-color=#f7768e
default-timeout=0

[mode=do-not-disturb]
invisible=1
