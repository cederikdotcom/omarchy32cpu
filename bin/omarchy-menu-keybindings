#!/bin/bash

# omarchy:summary=Display sway keybindings defined in your configuration using an interactive search menu.
# omarchy:args=[--print|-p]

# Omarchy CPU reads bindings from the sway config instead of `hyprctl binds`:
# `bindsym` lines from ~/.config/sway/config (falling back to
# /etc/sway/config), following one level of `include` directives. A trailing
# `# comment` on a bindsym line is shown as the description; otherwise the
# bound command is shown. Selecting an entry dispatches its command through
# swaymsg.

set -uo pipefail

main_config=""
for candidate in "$HOME/.config/sway/config" /etc/sway/config; do
  if [[ -f $candidate ]]; then
    main_config="$candidate"
    break
  fi
done

if [[ -z $main_config ]]; then
  echo "No sway config found (~/.config/sway/config or /etc/sway/config)" >&2
  exit 1
fi

# The main config plus everything its `include` lines pull in (one level,
# globs expanded, ~ and common variables resolved).
config_files() {
  local file="$1" line path expanded
  printf '%s\n' "$file"
  while IFS= read -r line; do
    [[ $line =~ ^[[:space:]]*include[[:space:]]+(.*)$ ]] || continue
    path="${BASH_REMATCH[1]}"
    path="${path%\"}" && path="${path#\"}"
    path="${path//\~/$HOME}"
    path="${path//\$HOME/$HOME}"
    for expanded in $path; do
      [[ -f $expanded ]] && printf '%s\n' "$expanded"
    done
  done <"$file"
}

# Emit "COMBO\t DESCRIPTION\tCOMMAND" records for every bindsym across the
# config set, expanding `set $var value` variables and normalizing modifiers.
binding_records() {
  local -A vars=()
  local file line name value flags combo command description

  while IFS= read -r file; do
    while IFS= read -r line; do
      # Variable definitions: set $name value
      if [[ $line =~ ^[[:space:]]*set[[:space:]]+(\$[A-Za-z0-9_]+)[[:space:]]+(.*)$ ]]; then
        vars["${BASH_REMATCH[1]}"]="${BASH_REMATCH[2]%%[[:space:]]#*}"
        continue
      fi

      [[ $line =~ ^[[:space:]]*bindsym[[:space:]]+(.*)$ ]] || continue
      line="${BASH_REMATCH[1]}"

      # Trailing comment becomes the description.
      description=""
      if [[ $line == *" # "* ]]; then
        description="${line##*\# }"
        line="${line%%\#*}"
      fi

      # Strip bindsym flags.
      while [[ $line =~ ^--(release|locked|inhibited|no-warn|no-repeat|border|exclude-titlebar|whole-window|to-code|input-device=[^[:space:]]+)[[:space:]]+ ]]; do
        line="${line:${#BASH_REMATCH[0]}}"
      done

      combo="${line%%[[:space:]]*}"
      command="${line#"$combo"}"
      command="${command#"${command%%[![:space:]]*}"}"
      command="${command%"${command##*[![:space:]]}"}"
      [[ -n $combo && -n $command ]] || continue

      # Expand $variables in combo and command.
      for name in "${!vars[@]}"; do
        value="${vars[$name]}"
        combo="${combo//"$name"/$value}"
        command="${command//"$name"/$value}"
      done

      # Readable modifiers and keys.
      combo="${combo//Mod4/SUPER}"
      combo="${combo//Mod1/ALT}"
      combo="${combo//Control/CTRL}"
      combo="${combo//Shift/SHIFT}"
      combo="${combo//+/ + }"

      printf '%s\t%s\t%s\n' "$combo" "$description" "$command"
    done <"$file"
  done < <(config_files "$main_config" | awk '!seen[$0]++')
}

# Render "COMBO → description-or-command<TAB>command" rows, cleaning the
# usual exec wrappers out of the display text.
format_records() {
  awk -F '\t' '
  {
    combo = $1
    description = $2
    command = $3

    action = description
    if (action == "") {
      action = command
      sub(/^exec[[:space:]]+--no-startup-id[[:space:]]+/, "", action)
      sub(/^exec[[:space:]]+/, "", action)
      gsub(/(^|[[:space:]])uwsm(-app| app)[[:space:]]+--[[:space:]]+/, " ", action)
      gsub(/^[ \t]+|[ \t]+$/, "", action)
    }

    if (action == "") next
    printf "%-35s → %s\t%s\n", combo, action, command
  }'
}

output_binding_records() {
  binding_records | sort -u | format_records
}

output_keybindings() {
  output_binding_records | cut -f1
}

if [[ ${1:-} == "--print" || ${1:-} == "-p" ]]; then
  output_keybindings
else
  records=$(output_binding_records)

  if [[ -z $records ]]; then
    echo "No keybindings found in $main_config" >&2
    exit 1
  fi

  selection=$(cut -f1 <<<"$records" |
    omarchy-menu-select 'Keybindings' -- --width 800 --height 500) || exit 0

  if [[ -n $selection ]]; then
    command=$(awk -F '\t' -v selection="$selection" '$1 == selection { print $2; exit }' <<<"$records")
    [[ -n $command ]] && swaymsg -- "$command" >/dev/null 2>&1
  fi
fi
