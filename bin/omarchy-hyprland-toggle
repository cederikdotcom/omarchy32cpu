#!/bin/bash

# omarchy:summary=Toggle permanent sway config flags by copying them into a directory that's included entirely.
# omarchy:args=<flag-name> [on|off|toggle]

usage() {
  echo "Usage: omarchy-hyprland-toggle <flag-name> [on|off|toggle]" >&2
}

if (($# < 1)); then
  usage
  exit 1
fi

FLAG_NAME="$1"
ACTION="${2:-toggle}"
FLAG_FILE="$HOME/.local/state/omarchy/toggles/sway/$FLAG_NAME.conf"
FLAG_SOURCE="$OMARCHY_PATH/default/sway/toggles/$FLAG_NAME.conf"

on() {
  mkdir -p "$(dirname "$FLAG_FILE")"

  # A flag with no shipped config snippet is still tracked as a marker file,
  # so state checks and callers that apply the effect live keep working.
  if [[ -f $FLAG_SOURCE ]]; then
    cp "$FLAG_SOURCE" "$FLAG_FILE"
  else
    : >"$FLAG_FILE"
  fi
}

off() {
  rm -f "$FLAG_FILE"
}

toggle() {
  if [[ -f $FLAG_FILE ]]; then
    off
    echo "off"
  else
    on
    echo "on"
  fi
}

case $ACTION in
  on) on ;;
  off) off ;;
  toggle) toggle ;;
  *)
    usage
    exit 1
    ;;
esac

swaymsg reload >/dev/null
