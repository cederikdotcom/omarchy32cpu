#!/bin/bash

# omarchy:summary=Pick a shell plugin to enable, disable, clone, or remove
# omarchy:group=menu
# omarchy:name=plugin
# omarchy:args=<enable|disable|clone|remove>

# The Quickshell plugin system does not exist in Omarchy CPU (the bar is
# waybar, configured in ~/.config/waybar/config.jsonc). Absorb the call so
# menu entries and scripts that still reference it do not break.

echo "omarchy-menu-plugin: shell plugins not available in Omarchy CPU" >&2
exit 0
