#!/bin/bash

# omarchy:summary=Toggle nightlight screen temperature
# omarchy:args=[--status]
# omarchy:examples=omarchy toggle nightlight

ON_TEMP=4000
OFF_TEMP=6500
STATE_FILE="$HOME/.local/state/omarchy/toggles/nightlight"

# wlsunset has no IPC to query, so the state file plus a live process is the
# nightlight state.
nightlight_on() {
  [[ -f $STATE_FILE ]] && pgrep -x wlsunset >/dev/null
}

status_json() {
  if nightlight_on; then
    jq -cn --argjson temp "$ON_TEMP" '{enabled:true, temperature:$temp}'
  else
    jq -cn --argjson temp "$OFF_TEMP" '{enabled:false, temperature:$temp}'
  fi
}

if [[ ${1:-} == "--status" ]]; then
  status_json
  exit 0
fi

if nightlight_on; then
  pkill -x wlsunset 2>/dev/null
  rm -f "$STATE_FILE"
else
  pkill -x wlsunset 2>/dev/null
  # Pinning the high temperature one Kelvin above the low holds the night
  # temperature around the clock; toggling off kills the process instead.
  setsid uwsm-app -- wlsunset -t $ON_TEMP -T $((ON_TEMP + 1)) >/dev/null 2>&1 &
  mkdir -p "$(dirname "$STATE_FILE")"
  touch "$STATE_FILE"
fi

omarchy-shell -q nightlight refresh
