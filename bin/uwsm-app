#!/bin/bash

# omarchy:summary=Launch an app detached from the caller (uwsm-less stand-in)
# omarchy:hidden=true

# uwsm is not packaged for archlinux32 i686, so Omarchy CPU starts Hyprland
# directly (bin/omarchy-hyprland-launch) and there is no uwsm-app on PATH.
# Callers throughout bin/ still launch apps by that name; keep the name and the
# detach semantics without the session manager. Drop this shim if uwsm ever
# joins the package set.

[[ ${1:-} == "--" ]] && shift
exec setsid -f "$@"
