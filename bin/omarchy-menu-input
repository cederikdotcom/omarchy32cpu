#!/bin/bash

# omarchy:summary=Prompt for text input from a menu
# omarchy:group=menu
# omarchy:name=input
# omarchy:args=prompt [menu args...]
# omarchy:examples=omarchy menu input Reminder|omarchy-menu-input "Reminder in minutes" --width 400

# Omarchy CPU renders the prompt with fuzzel --dmenu over an empty candidate
# list: with nothing to match, fuzzel prints the typed text on Enter. Prints
# the entered text on stdout; exits 1 on cancel or empty input.

set -euo pipefail

prompt="${1:-Input}"
if (($# > 0)); then
  shift
fi

menu_width=""

while (($# > 0)); do
  case "$1" in
    --width)
      shift
      if (($# == 0)); then
        echo "omarchy-menu-input: --width requires a value" >&2
        exit 1
      fi
      menu_width="$1"
      ;;
  esac
  shift
done

fuzzel_args=(--dmenu --lines 0 --prompt "$prompt > ")

if [[ $menu_width =~ ^[0-9]+$ ]] && ((menu_width > 0)); then
  chars=$((menu_width / 10))
  ((chars < 30)) && chars=30
  fuzzel_args+=(--width "$chars")
fi

input=$(fuzzel "${fuzzel_args[@]}" </dev/null) || exit 1
[[ -n $input ]] || exit 1
printf '%s\n' "$input"
