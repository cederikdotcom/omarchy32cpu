#!/bin/bash

# omarchy:summary=Point mako at the current Omarchy theme and reload it
# omarchy:hidden=true

# mako has no include directive, so the theme pipeline renders the whole
# config (default/themed/mako.ini.tpl) into the current theme directory and
# this helper keeps ~/.config/mako/config pointing at it. The theme swap
# replaces the directory behind the symlink, so relinking is only needed the
# first time, but ln -nsf makes that idempotent.

THEME_MAKO_CONFIG="$HOME/.local/state/omarchy/current/theme/mako.ini"
MAKO_CONFIG="$HOME/.config/mako/config"

[[ -f $THEME_MAKO_CONFIG ]] || exit 0

mkdir -p "${MAKO_CONFIG%/*}"
ln -nsf "$THEME_MAKO_CONFIG" "$MAKO_CONFIG"

if pgrep -x mako >/dev/null; then
  makoctl reload >/dev/null 2>&1 || true
fi
