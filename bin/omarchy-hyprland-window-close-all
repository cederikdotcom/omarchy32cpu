#!/bin/bash

# omarchy:summary=Close all open windows

swaymsg -t get_tree |
  jq -r '.. | objects | select(.type? == "con" or .type? == "floating_con") | select(.pid != null) | .id' |
  while read -r id; do
    swaymsg "[con_id=$id] kill" >/dev/null
  done

# Move to first workspace
swaymsg 'workspace number 1' >/dev/null
