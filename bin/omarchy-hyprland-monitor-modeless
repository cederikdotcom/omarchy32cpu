#!/bin/bash

# omarchy:summary=Returns true when sway has an enabled monitor with no mode
# omarchy:hidden=true

# A monitor powered off at boot answers with a partial EDID carrying no video
# modes, so the compositor brings it up with no usable mode and the screen
# stays black.
#
# Exits 0 modeless, 1 not, 2 when the compositor cannot say. Nothing fires an
# event for this state, so a caller that gave up on an unanswered query would
# leave the screen black for good.
outputs=$(swaymsg -t get_outputs 2>/dev/null) || exit 2

state=$(jq 'if any(.[]; .active == true and (((.current_mode.width // 0) == 0) or ((.current_mode.height // 0) == 0))) then 0 else 1 end' \
  <<<"$outputs" 2>/dev/null)

case $state in
  0 | 1) exit "$state" ;;
  *) exit 2 ;;
esac
