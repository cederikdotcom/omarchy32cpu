#!/bin/bash

# omarchy:summary=Manage the waybar status bar
# omarchy:group=bar
# omarchy:args=[start|stop|restart|reload|toggle|status]
# omarchy:examples=omarchy bar reload | omarchy bar toggle

# Omarchy Omarchy CPU replaces the Quickshell bar with waybar. The old widget
# layout commands (use/put/move/set/position/transparent/defaults) edited
# shell.json for Quickshell; they are absorbed here so callers like
# omarchy-refresh-shell keep working.

set -euo pipefail

fail() {
  echo "${0##*/}: $*" >&2
  exit 1
}

usage() {
  cat <<USAGE
Usage: omarchy bar <command>

  start      Start waybar if it is not running
  stop       Stop waybar
  restart    Stop and start waybar
  reload     Re-read the waybar config (SIGUSR2)
  toggle     Toggle bar visibility (SIGUSR1)
  status     Report whether waybar is running

Legacy Quickshell layout commands (use, reset, defaults, position,
transparent, put, move, set) are not available in Omarchy CPU; they
print a note and return success. Edit ~/.config/waybar/config.jsonc
instead, then run 'omarchy bar reload'.
USAGE
}

bar_running() {
  pgrep -x waybar >/dev/null
}

cmd_start() {
  bar_running && return 0
  omarchy-cmd-present waybar || fail "waybar is not installed"
  setsid -f waybar >/dev/null 2>&1
}

cmd_stop() {
  pkill -x waybar 2>/dev/null || true
}

command="${1:-help}"
(($# > 0)) && shift || true

case "$command" in
  start)
    cmd_start
    ;;
  stop)
    cmd_stop
    ;;
  restart)
    cmd_stop
    # waybar releases its layer surface on exit; give the compositor a beat.
    sleep 0.2
    cmd_start
    ;;
  reload)
    bar_running && pkill -SIGUSR2 -x waybar
    ;;
  toggle)
    if bar_running; then
      pkill -SIGUSR1 -x waybar
    else
      cmd_start
    fi
    ;;
  status)
    if bar_running; then
      echo "waybar is running"
    else
      echo "waybar is not running"
      exit 1
    fi
    ;;
  use | reset | defaults | position | transparent | put | move | set)
    echo "omarchy-bar $command: not available in Omarchy CPU (edit ~/.config/waybar/config.jsonc)" >&2
    exit 0
    ;;
  -h | --help | help)
    usage
    ;;
  *)
    fail "unknown command: $command"
    ;;
esac
