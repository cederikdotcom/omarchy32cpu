#!/bin/bash

# omarchy:summary=Watch sway outputs and recover monitor toggles when they change

LOCK="${XDG_RUNTIME_DIR:-/tmp}/omarchy-monitor-clamshell.lock"
MODELESS_LOCK="${XDG_RUNTIME_DIR:-/tmp}/omarchy-monitor-modeless.lock"

sync_clamshell() {
  (
    flock -n 9 || exit 0
    omarchy-hyprland-monitor-clamshell
  ) 9>"$LOCK"
}

sync_clamshell_after_monitor_change() {
  sync_clamshell

  (
    for delay in 1 3 7; do
      sleep "$delay"
      sync_clamshell
    done
  ) &
}

# Powering the monitor on fires no DRM hotplug, and forcing a re-probe needs
# root, so only a reload re-reads the EDID and only a reload reveals whether it
# worked. Back off: the machine can sit like this all night. The lock keeps one
# loop running across the changes that call this; the wait is for a change
# landing in the moment one is exiting, which would otherwise be the last one
# to come.
recover_modeless() {
  (
    flock -w 1 9 || exit 0

    local delay=3 state unanswered=0

    while true; do
      omarchy-hyprland-monitor-modeless
      state=$?

      # A monitor reporting a mode is recovered. One the compositor cannot speak
      # for is not an answer, and nothing else will ask again -- but a compositor
      # that stays silent has gone, taking the session and this loop's reason
      # with it.
      (( state == 1 )) && break
      (( state == 2 )) && (( ++unanswered > 20 )) && break
      (( state == 0 )) && unanswered=0

      if (( state == 0 )); then
        swaymsg reload >/dev/null 2>&1 || true
      fi

      sleep "$delay"
      (( delay = delay * 2 > 60 ? 60 : delay * 2 ))
    done
  ) 9>"$MODELESS_LOCK" &
}

# sway 1.8 exposes no output event over IPC (subscribing to ["output"] fails),
# so poll the output topology and react to changes. The steady-state iteration
# also reconciles clamshell drift while docked: the internal panel is only ever
# disabled while a laptop drives an external monitor with the lid shut, and
# drift there (e.g. across suspend/resume) changes no topology. A compositor
# that stops answering has gone, taking the session and this loop's reason
# with it.
failures=0
previous=""

while true; do
  current=$(swaymsg -t get_outputs 2>/dev/null | jq -c '[.[] | {name, active}]' 2>/dev/null)

  if [[ -z $current ]]; then
    (( ++failures > 15 )) && exit 0
  else
    failures=0

    if [[ $current != "$previous" ]]; then
      previous=$current
      sync_clamshell_after_monitor_change
      recover_modeless
    elif omarchy-hw-laptop && omarchy-hyprland-monitor-external-active; then
      sync_clamshell
    fi
  fi

  sleep 2
done
