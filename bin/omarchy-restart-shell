#!/bin/bash

# omarchy:summary=Restart the Omarchy shell
# omarchy:examples=omarchy restart shell

# Omarchy CPU's shell is waybar (bar) plus mako (notifications); restart both.
# swaylock is its own process, so unlike the Quickshell shell a restart never
# threatens an active session lock, and none of upstream's relock dance is
# needed here. Restore this script with the Quickshell shell (issue #2).

# Allow running from outside the session (e.g. over ssh) by deriving the
# Hyprland instance signature from the newest instance runtime dir.
if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  hypr_dir=$(find "${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -n 1 | cut -d' ' -f2-)
  [[ -n $hypr_dir ]] && export HYPRLAND_INSTANCE_SIGNATURE=${hypr_dir##*/}
fi

omarchy-bar stop
pkill -x mako 2>/dev/null

# Spawn from Hyprland so the shell inherits the canonical session environment,
# not transient variables from a terminal, SSH connection, or development
# tool. Without a compositor to ask, launch directly as a best effort.
if ! hyprctl dispatch 'hl.dsp.exec_cmd("omarchy-launch-shell")' >/dev/null 2>&1; then
  omarchy-launch-shell
fi

for (( attempt = 0; attempt < 50; attempt++ )); do
  omarchy-bar status >/dev/null 2>&1 && exit 0
  sleep 0.1
done

echo "Omarchy shell did not become ready after restart." >&2
exit 1
