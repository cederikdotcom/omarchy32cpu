#!/bin/bash

# omarchy:summary=Save or restore the focused window width
# omarchy:args=<save|restore>
# omarchy:examples=omarchy hyprland window width save | omarchy-hyprland-window-width restore

set -euo pipefail

STATE_DIR="$HOME/.local/state/omarchy/windows"

usage() {
  echo "Usage: omarchy-hyprland-window-width save|restore" >&2
  exit 1
}

active_window() {
  swaymsg -t get_tree 2>/dev/null |
    jq -c '[.. | objects | select(.type? == "con" or .type? == "floating_con") | select(.focused == true)] | first // empty'
}

window_key() {
  jq -r '[.app_id, .window_properties.class, .name] | map(select(. != null and . != "")) | first // empty' <<<"$1"
}

workspace_key() {
  swaymsg -t get_workspaces | jq -r 'first(.[] | select(.focused == true)) | .num // .name // empty'
}

state_file_for() {
  local key="$1"
  local workspace="$2"
  local filename="workspace-${workspace}-${key}"

  filename="${filename//\//_}"
  filename="${filename//$'\n'/_}"

  printf '%s/%s.width' "$STATE_DIR" "$filename"
}

notify_missing_width() {
  local key="$1"
  local workspace="$2"

  omarchy-notification-send -g  "No saved width found for $key on workspace $workspace" "Use Super + Alt + Home to save one for this workspace."
}

notify_saved_width() {
  local key="$1"
  local workspace="$2"

  omarchy-notification-send -g  "Saved width for $key on workspace $workspace" "Restore using Super + Home on this workspace."
}

save_width() {
  local active="$1"
  local key="$2"
  local workspace="$3"
  local state_file="$4"
  local tmp=""
  local width=""

  width=$(jq -er '.rect.width' <<<"$active")

  mkdir -p "$STATE_DIR"
  tmp=$(mktemp "$STATE_DIR/.width.XXXXXX")
  printf '%s\n' "$width" >"$tmp"
  mv "$tmp" "$state_file"

  notify_saved_width "$key" "$workspace"
  echo "Saved width for $key on workspace $workspace"
}

restore_width() {
  local key="$1"
  local workspace="$2"
  local state_file="$3"
  local width=""

  if [[ ! -f $state_file ]]; then
    notify_missing_width "$key" "$workspace"
    exit 1
  fi

  width=$(<"$state_file")
  [[ $width =~ ^[0-9]+$ ]] || exit 1

  swaymsg "resize set width $width px" >/dev/null
}

action=${1:-}
[[ $action == "save" || $action == "restore" ]] || usage

active=$(active_window)
[[ -n $active ]] || exit 1
key=$(window_key "$active")
[[ -n $key ]] || exit 1
workspace=$(workspace_key)
[[ -n $workspace ]] || exit 1

state_file=$(state_file_for "$key" "$workspace")

case "$action" in
save) save_width "$active" "$key" "$workspace" "$state_file" ;;
restore) restore_width "$key" "$workspace" "$state_file" ;;
esac
