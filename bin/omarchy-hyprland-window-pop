#!/bin/bash

# omarchy:summary=Toggle to pop-out a tile to stay fixed on a display basis.
# omarchy:args=[width height x y]

width=${1:-1300}
height=${2:-900}
x=${3:-}
y=${4:-}

# All four are interpolated into swaymsg command strings, so only numbers pass.
for value in "$width" "$height" ${x:+"$x"} ${y:+"$y"}; do
  [[ $value =~ ^-?[0-9]+$ ]] || exit 1
done

active=$(swaymsg -t get_tree | jq -c '[.. | objects | select(.type? == "con" or .type? == "floating_con") | select(.focused == true)] | first // empty')
[[ -n $active ]] || exit 0

if [[ $(jq -r '.sticky // false' <<<"$active") == "true" ]]; then
  swaymsg 'sticky disable; floating disable' >/dev/null
else
  swaymsg "floating enable; resize set ${width} px ${height} px" >/dev/null

  if [[ -n $x && -n $y ]]; then
    swaymsg "move absolute position $x $y" >/dev/null
  else
    swaymsg 'move position center' >/dev/null
  fi

  swaymsg 'sticky enable' >/dev/null
fi
