#!/bin/bash

# omarchy:summary=Compositor-neutral window, workspace, and monitor operations over sway IPC
# omarchy:args=<verb> [args]
# omarchy:hidden=true

# Verbs:
#   focused-window                    print the focused window's app_id and title (two lines)
#   focused-monitor                   print the focused output name
#   workspace-list                    print all workspace names
#   workspace-current                 print the focused workspace name
#   move-to-workspace <n>             move the focused window to workspace n and follow it
#   fullscreen-toggle                 toggle fullscreen on the focused window
#   focus-app <pattern> [command...]  focus the first window whose app_id, class, or title
#                                     matches the regex, or exec the fallback command

usage() {
  echo "Usage: omarchy-compositor-ctl <focused-window|focused-monitor|workspace-list|workspace-current|move-to-workspace <n>|fullscreen-toggle|focus-app <pattern> [command...]>" >&2
  exit 1
}

# Every window in the sway tree, views only (containers carry no pid).
windows() {
  swaymsg -t get_tree | jq '[.. | objects | select(.type? == "con" or .type? == "floating_con") | select(.pid != null)]'
}

case "${1:-}" in
focused-window)
  windows | jq -r 'first(.[] | select(.focused == true)) | "\(.app_id // .window_properties.class // "")\n\(.name // "")"'
  ;;
focused-monitor)
  swaymsg -t get_outputs | jq -r '.[] | select(.focused == true).name'
  ;;
workspace-list)
  swaymsg -t get_workspaces | jq -r '.[].name'
  ;;
workspace-current)
  swaymsg -t get_workspaces | jq -r '.[] | select(.focused == true).name'
  ;;
move-to-workspace)
  [[ ${2:-} =~ ^[0-9]+$ ]] || usage
  swaymsg "move container to workspace number $2; workspace number $2" >/dev/null
  ;;
fullscreen-toggle)
  swaymsg fullscreen toggle >/dev/null
  ;;
focus-app)
  [[ -n ${2:-} ]] || usage
  con_id=$(
    windows | jq -r --arg pattern "$2" \
      'def matches($value): ($value // "") | test($pattern; "i");
       first(.[] | select(matches(.app_id) or matches(.window_properties.class) or matches(.name))).id // empty'
  )

  if [[ -n $con_id ]]; then
    swaymsg "[con_id=$con_id] focus" >/dev/null
  elif (($# >= 3)); then
    shift 2
    exec setsid uwsm-app -- "$@"
  else
    exit 1
  fi
  ;;
*)
  usage
  ;;
esac
