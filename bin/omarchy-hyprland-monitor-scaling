#!/bin/bash

# omarchy:summary=Show, set, or adjust focused monitor scaling
# omarchy:args=[up|down|SCALE]
# omarchy:examples=omarchy hyprland monitor scaling | omarchy hyprland monitor scaling 1.6 | omarchy hyprland monitor scaling up | omarchy hyprland monitor scaling down

SCALES=(1 1.25 1.6 2 3 4)
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
SCALE_LOG="$STATE_DIR/monitor-scaling.log"
SCALE_CONF="$HOME/.local/state/omarchy/toggles/sway/monitor-scale.conf"

usage() {
  echo "Usage: omarchy-hyprland-monitor-scaling [up|down|SCALE]"
}

focused_monitor() {
  swaymsg -t get_outputs | jq -e -c '.[] | select(.focused == true)'
}

cmdline_for_pid() {
  local pid="$1"

  [[ -r /proc/$pid/cmdline ]] || return 0
  tr '\0\t\n' '   ' <"/proc/$pid/cmdline" | sed -E 's/[[:space:]]+/ /g; s/[[:space:]]+$//'
}

audit_scale_change() {
  local requested="$1"
  local active_monitor="$2"
  local current_scale="$3"
  local new_scale="$4"
  local parent_pid="$PPID"
  local grandparent_pid
  local parent_cmd
  local grandparent_cmd

  mkdir -p "$STATE_DIR" || return 0

  grandparent_pid=$(ps -o ppid= -p "$parent_pid" 2>/dev/null | tr -d ' ')
  parent_cmd=$(cmdline_for_pid "$parent_pid")
  grandparent_cmd=$(cmdline_for_pid "$grandparent_pid")

  printf 'at=%s\trequested=%s\tcurrent=%s\tnew=%s\tmonitor=%s\tpid=%s\tppid=%s\tparent=%s\tgppid=%s\tgrandparent=%s\n' \
    "$(date --iso-8601=seconds)" \
    "$requested" \
    "$current_scale" \
    "$new_scale" \
    "$active_monitor" \
    "$$" \
    "$parent_pid" \
    "$parent_cmd" \
    "$grandparent_pid" \
    "$grandparent_cmd" >>"$SCALE_LOG"
}

normalize_scale() {
  awk 'NR == 1 { printf "%g\n", $0 }'
}

set_scale() {
  local new_scale="$1"
  local requested="${2:-$new_scale}"
  local monitor_info active_monitor current_scale

  monitor_info=$(focused_monitor) || exit 1
  active_monitor=$(jq -r '.name' <<<"$monitor_info")
  current_scale=$(jq -r '.scale' <<<"$monitor_info")

  # active_monitor is interpolated into swaymsg command strings, so only a
  # plain connector name may pass; a hostile output name could smuggle in
  # extra commands otherwise.
  if [[ ! $active_monitor =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Refusing unsafe monitor name" >&2
    exit 1
  fi

  swaymsg "output $active_monitor scale $new_scale" >/dev/null
  audit_scale_change "$requested" "$active_monitor" "$current_scale" "$new_scale"

  # Persist so a sway reload restores the scale from the toggles include.
  mkdir -p "$(dirname "$SCALE_CONF")"
  printf 'output %s scale %s\n' "$active_monitor" "$new_scale" >"$SCALE_CONF"
}

scale_from_current() {
  local direction="${1:-}"

  awk -v direction="$direction" -v list="${SCALES[*]}" '
    NR == 1 { scale = $0; found = 1 }
    END {
      if (!found) exit 1

      n = split(list, scales, " ")

      # Snap to the nearest preset first. sway reports floating point values,
      # so exact comparisons can otherwise get stuck.
      best = 1; best_diff = 1e9
      for (i = 1; i <= n; i++) {
        diff = scale - scales[i]; if (diff < 0) diff = -diff
        if (diff < best_diff) { best_diff = diff; best = i }
      }

      if (direction == "next") {
        print scales[(best < n ? best + 1 : n)]
      } else if (direction == "previous") {
        print scales[(best > 1 ? best - 1 : 1)]
      } else {
        print scales[best]
      }
    }'
}

case "${1:-}" in
"")
  focused_monitor | jq -r '.scale' | normalize_scale
  ;;
-h | --help)
  usage
  ;;
up)
  set_scale "$(focused_monitor | jq -r '.scale' | scale_from_current next)" "up"
  ;;
down)
  set_scale "$(focused_monitor | jq -r '.scale' | scale_from_current previous)" "down"
  ;;
1 | 1.25 | 1.6 | 2 | 3 | 4)
  set_scale "$1" "$1"
  ;;
*)
  if [[ $1 =~ ^[0-9]+([.][0-9]+)?$ ]] &&
    awk -v scale="$1" 'BEGIN { exit !(scale >= 1 && scale <= 4) }'; then
    set_scale "$1" "$1"
  else
    usage >&2
    exit 1
  fi
  ;;
esac
