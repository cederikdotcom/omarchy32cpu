#!/bin/bash

# omarchy:summary=Pause or resume compositor config auto-reload around package transactions.
# omarchy:hidden=true

# sway only reloads its config on an explicit `swaymsg reload`, so there is
# nothing to pause. The verbs remain for callers: pause and resume succeed as
# no-ops, and paused always reports not paused.
case "${1:-}" in
  pause | resume) exit 0 ;;
  paused) exit 1 ;;
  *)
    echo "Usage: omarchy-hyprland-reload-guard pause|resume|paused" >&2
    exit 1
    ;;
esac
