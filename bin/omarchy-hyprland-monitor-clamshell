#!/bin/bash

# omarchy:summary=Apply clamshell display state to the internal monitor
# omarchy:hidden=true

# sway's bindswitch handles the lid edge itself; this reconciles drift those
# binds can miss (boot with the lid shut, suspend/resume, monitor hotplug).

INTERNAL=$(omarchy-hyprland-monitor-laptop)
[[ -n $INTERNAL ]] || exit 0

# The name is interpolated into a swaymsg command string, so only a plain
# connector name may pass.
if [[ ! $INTERNAL =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Refusing unsafe internal monitor name" >&2
  exit 1
fi

internal_active() {
  swaymsg -t get_outputs | jq -e --arg internal "$INTERNAL" \
    '.[] | select(.name == $internal and .active == true)' >/dev/null 2>&1
}

omarchy-hyprland-monitor-internal recover >/dev/null 2>&1 || true

if omarchy-hw-clamshell && omarchy-hyprland-monitor-external-active; then
  if internal_active; then
    swaymsg "output $INTERNAL disable" >/dev/null
  fi
else
  # A manual disable (omarchy-hyprland-monitor-internal off) stays in force
  # while an external monitor is still active.
  if omarchy-hyprland-toggle-enabled internal-monitor-disable && omarchy-hyprland-monitor-external-active; then
    exit 0
  fi

  if ! internal_active; then
    swaymsg "output $INTERNAL enable" >/dev/null
    swaymsg "output $INTERNAL power on" >/dev/null 2>&1 || true
  fi
fi
