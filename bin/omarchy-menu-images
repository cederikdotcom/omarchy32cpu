#!/bin/bash

# omarchy:summary=Open a generic image selector menu
# omarchy:args=[--selected <image>] [--print-name] [--show-labels] [--filterable] [--lazy-thumbnails] [--preload] [--cache-only] <image-dir>...

# Omarchy CPU has no Quickshell image grid (and no GPU worth thumbnailing
# on), so the selector is a fuzzel list of image names. The calling contract
# is unchanged: the selected image's full path is printed (or its bare name
# with --print-name), nothing is printed on cancel, and the thumbnail-cache
# flags (--cache-only, --prepare-only, --preload, --lazy-thumbnails) are
# accepted as no-ops.

set -euo pipefail

selected_image=""
print_name=false
image_dirs=()

usage() {
  echo "Usage: omarchy-menu-images [--selected <image>] [--print-name] [--show-labels] [--filterable] [--lazy-thumbnails] [--preload] [--cache-only] <image-dir>..."
}

while (($# > 0)); do
  case "$1" in
    --selected)
      if (($# < 2)); then
        usage >&2
        exit 1
      fi
      selected_image="$2"
      shift 2
      ;;
    --print-name)
      print_name=true
      shift
      ;;
    --show-labels | --filterable | --lazy-thumbnails)
      shift
      ;;
    --prepare-only | --preload | --cache-only)
      # Thumbnail cache management: nothing to do without thumbnails.
      cache_flag=true
      shift
      ;;
    --help | -h)
      usage
      exit 0
      ;;
    *)
      image_dirs+=("$1")
      shift
      ;;
  esac
done

if ((${#image_dirs[@]} == 0)); then
  usage >&2
  exit 1
fi

if [[ ${cache_flag:-false} == true ]]; then
  exit 0
fi

# Collect image files (same extensions as the Quickshell selector).
images=()
while IFS= read -r -d '' image; do
  images+=("$image")
done < <(
  for dir in "${image_dirs[@]}"; do
    [[ -d $dir ]] || continue
    find -L "$dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.webp' \) -print0 2>/dev/null
  done | sort -z
)

if ((${#images[@]} == 0)); then
  echo "No images found" >&2
  exit 1
fi

# Show the current selection first so Enter keeps it.
current=$(readlink -f "$selected_image" 2>/dev/null || true)
if [[ -n $current ]]; then
  ordered=()
  rest=()
  for image in "${images[@]}"; do
    if [[ $(readlink -f "$image" 2>/dev/null) == "$current" ]]; then
      ordered+=("$image")
    else
      rest+=("$image")
    fi
  done
  images=("${ordered[@]}" "${rest[@]}")
fi

# Rows show the bare name; selection maps back by index so duplicate names
# across directories stay unambiguous.
rows() {
  local image name
  for image in "${images[@]}"; do
    name="${image##*/}"
    printf '%s\n' "${name%.*}"
  done
}

lines=${#images[@]}
((lines > 14)) && lines=14

index=$(rows | fuzzel --dmenu --index --prompt "Select image > " --lines "$lines" --width 50) || exit 0
[[ $index =~ ^[0-9]+$ ]] || exit 0
((index < ${#images[@]})) || exit 0

selection="${images[$index]}"

if [[ $print_name == true ]]; then
  selection="${selection##*/}"
  printf '%s\n' "${selection%.*}"
else
  printf '%s\n' "$selection"
fi
