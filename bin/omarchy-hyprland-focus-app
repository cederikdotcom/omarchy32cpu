#!/bin/bash

# omarchy:summary=Focus a window by application identity
# omarchy:args=<app-name>
# omarchy:examples=omarchy hyprland focus app Slack

usage() {
  echo "Usage: omarchy-hyprland-focus-app <app-name>" >&2
  exit 1
}

app=${1:-}
[[ -n $app ]] || usage

exec omarchy-compositor-ctl focus-app "$app"
