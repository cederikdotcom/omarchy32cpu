#!/bin/bash

# omarchy:summary=Launch the Omarchy shell components (waybar + mako)
# omarchy:hidden=true

# Omarchy CPU's shell is waybar (bar) plus mako (notifications). The sway
# session starts both itself; this launcher exists for omarchy-restart-shell
# and anyone who needs the shell back without bouncing the session. The old
# Quickshell supervisor (relaunch budget, compositor probes) is gone: waybar
# and mako are plain processes with no self-reload to babysit.

omarchy-bar start

pgrep -x mako >/dev/null || setsid -f mako >/dev/null 2>&1

exit 0
