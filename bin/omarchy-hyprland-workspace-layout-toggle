#!/bin/bash

# omarchy:summary=Toggle the tiling layout for the focused window's container

swaymsg 'layout toggle splith splitv tabbed' >/dev/null

# Report the layout the toggle landed on: the focused window's parent layout.
layout=$(swaymsg -t get_tree | jq -r '
  [.. | objects | select(.nodes? or .floating_nodes?)
   | select([.nodes[]?, .floating_nodes[]?] | any(.focused == true))]
  | first.layout // empty')

if [[ -n $layout ]]; then
  omarchy-notification-send -g 󱂬 "Workspace layout set to $layout"
else
  omarchy-notification-send -g 󱂬 "Workspace layout toggled"
fi
