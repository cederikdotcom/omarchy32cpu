#!/bin/bash

# omarchy:summary=Launch the Omarchy screensaver in the default terminal on the system with the correct font configuration.

if omarchy-cmd-missing ttfx; then
  exit 1
fi

# Exit early if screensaver is already running
pgrep -f '[o]rg.omarchy.screensaver' && exit 0

# Allow screensaver to be turned off but also force started
if omarchy-toggle-enabled screensaver-off && [[ $1 != "force" ]]; then
  exit 1
fi

focused=$(omarchy-hyprland-monitor-focused)
terminal=$(xdg-terminal-exec --print-id)

case $terminal in
*Alacritty* | *ghostty* | *foot* | *kitty*) ;;
*)
  omarchy-notification-send -g ✋ "Screensaver only runs in Alacritty, Foot, Ghostty, or Kitty"
  exit 1
  ;;
esac

sway_focus_monitor() {
  # Names come from sway and are interpolated into a command string, so only
  # plain connector names may pass.
  [[ $1 =~ ^[A-Za-z0-9._-]+$ ]] || return 0
  swaymsg "focus output $1" >/dev/null 2>&1
}

sway_exec() {
  local command
  printf -v command '%q ' "$@"

  swaymsg exec -- "$command" >/dev/null 2>&1
}

# Open sway's window event stream before spawning anything, so a terminal that
# maps quickly can't emit its "new" event before we are listening for it.
exec {events}< <(swaymsg -r -t subscribe -m '["window"]')

# sway_exec is async and a new window maps on whatever monitor is focused at that
# moment. Block until this monitor's screensaver actually opens before moving
# focus on -- otherwise slow-starting terminals all pile onto the last monitor.
# The deadline is a safety net in case the window never appears.
wait_for_screensaver_window() {
  local line deadline=$((SECONDS + 5))
  while ((SECONDS < deadline)) && IFS= read -r -t $((deadline - SECONDS)) -u "$events" line; do
    jq -e 'select(.change == "new") | .container.app_id == "org.omarchy.screensaver"' <<<"$line" >/dev/null 2>&1 && return 0
  done
}

for m in $(swaymsg -t get_outputs | jq -r '.[] | select(.active == true) | .name'); do
  sway_focus_monitor "$m"

  case $terminal in
  *Alacritty*)
    sway_exec alacritty --class=org.omarchy.screensaver --config-file "$OMARCHY_PATH/default/alacritty/screensaver.toml" -e omarchy-screensaver
    ;;
  *ghostty*)
    sway_exec ghostty --class=org.omarchy.screensaver --config-file="$OMARCHY_PATH/default/ghostty/screensaver" --font-size=18 -e omarchy-screensaver
    ;;
  *foot*)
    sway_exec foot --app-id=org.omarchy.screensaver --config="$OMARCHY_PATH/default/foot/screensaver.ini" -e omarchy-screensaver
    ;;
  *kitty*)
    sway_exec kitty --class=org.omarchy.screensaver --override font_size=18 --override window_padding_width=0 -e omarchy-screensaver
    ;;
  esac

  wait_for_screensaver_window
done

sway_focus_monitor "$focused"
