# Packages installed outside of install/packages.sh or optional packages
# Utilized by ISO builder to ensure package availability in the ISO

base-devel
gst-plugin-pipewire
libpulse
pipewire-alsa
pipewire-jack
wireless-regdb

# A1181 MacBook support packages. Neither is in the archlinux32 repos (both
# are AUR upstream); they are self-built for the fork package repo, and
# install/hardware/apple/fix-a1181.sh skips them gracefully while absent.
mbpfan
isight-firmware-tools
