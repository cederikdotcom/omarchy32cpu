### Bar ########################################################################

bar {
  swaybar_command waybar
}

### Autostart (from default/hypr/autostart.lua) ################################

# Slow app launch fix: set systemd vars before starting session services.
exec systemctl --user import-environment $(env | cut -d'=' -f 1) && dbus-update-activation-environment --systemd --all

# Notifications (mako replaces the Quickshell notification surface).
exec mako

# Wallpaper: the current theme background symlink.
exec swaybg -m fill -i "$HOME/.local/state/omarchy/current/background"

# Idle management (swayidle replaces hypridle; omarchy-system-lock wraps swaylock).
exec swayidle -w timeout 300 'omarchy-system-lock' timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' before-sleep 'omarchy-system-lock'

exec omarchy-provision-first-run
exec omarchy-powerprofiles-init

# Re-apply persisted input-device disables (omarchy-toggle-input-device stores
# the device name as data). exec_always so a config reload re-applies them too.
exec_always bash -c 'for f in "$HOME"/.local/state/omarchy/toggles/sway/*-disabled-name; do [[ -f $f ]] && swaymsg -- input "$(<"$f")" events disabled; done; true'

# Run post-boot hooks after startup config has loaded.
exec sleep 2 && omarchy-hook post-boot

# Dropped from autostart with the Lite scope: omarchy-launch-shell (Quickshell),
# omarchy-hyprland-monitor-watch (Hyprland IPC watcher), udiskie (not in the
# Lite package set).

### Includes ###################################################################

# System-wide drop-ins.
include /etc/sway/config.d/*

# Current theme colors (optional; the glob means a theme without a sway file
# is fine). The theme pipeline renders this file as .../current/theme/sway.
include ~/.local/state/omarchy/current/theme/sway*

# User drop-ins.
include ~/.config/sway/config.d/*
