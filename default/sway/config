# Omarchy 32-bit Lite: default sway configuration.
#
# Faithful translation of the Hyprland Lua defaults (default/hypr/) for
# sway 1.8 with the pixman renderer on the 2006 MacBook1,1 (1280x800).
# Don't edit this file directly: personal overrides belong in
# ~/.config/sway/config (see config/sway/config), which includes this file
# first and can rebind or reconfigure anything after the include.
#
# Session environment (WLR_RENDERER=pixman, OMARCHY_PATH, PATH, keyboard
# layout from /etc/vconsole.conf) is exported by bin/omarchy-sway-launch
# before sway starts; the Lua envs.lua logic lives there now.

### Variables ##################################################################

set $mod Mod4

### Look and feel (from default/hypr/looknfeel.lua) ############################

# no sway equivalent: animations, blur, shadows, rounding (dropped with pixman anyway)
# no sway equivalent: per-window opacity/transparency rules (pixman renderer)

gaps inner 5
gaps outer 10

default_border pixel 2
default_floating_border pixel 2

# Titlebars only show on tabbed/stacked containers (the "group" stand-in).
font pango:monospace 10

# Border colors from looknfeel.lua (active 33ccff gradient start, inactive
# 595959). Themes override these via the theme include at the bottom.
# class                 border  background text    indicator child_border
client.focused          #33ccff #33ccff    #ffffff #00ff99   #33ccff
client.focused_inactive #595959 #333333    #ffffff #595959   #595959
client.unfocused        #595959 #222222    #888888 #595959   #595959
client.urgent           #ff5555 #ff5555    #ffffff #ff5555   #ff5555

focus_follows_mouse yes
mouse_warping output
focus_on_window_activation focus

# cursor.hide_on_key_press from looknfeel.lua.
seat * hide_cursor when-typing enable

### Input (from default/hypr/input.lua) ########################################

# Keyboard layout/variant/options come from XKB_DEFAULT_* exported by
# omarchy-sway-launch (which reads /etc/vconsole.conf and applies the
# non-Latin-layout fallback). Only the non-layout settings live here.
input type:keyboard {
  repeat_rate 40
  repeat_delay 250
  xkb_numlock enabled
}

input type:touchpad {
  natural_scroll disabled
  click_method clickfinger
  scroll_factor 0.4
  tap enabled
}

# no sway equivalent: per-app touchpad scroll_factor (terminal scroll speed rules)

### Window rules (from default/hypr/windows.lua + apps/) #######################

# Floating-window treatment: float, center, 875x600.
for_window [app_id="^(org\.omarchy\..*|org\.codeberg\.dnkl\.foot|TUI\.float|imv|mpv|org\.gnome\.NautilusPreviewer|org\.gnome\.Evince)$"] floating enable, resize set 875 600, move position center
for_window [class="^(Omarchy|About|TUI\.float|imv|mpv)$"] floating enable, resize set 875 600, move position center

# Portal windows are always dialogs; float them all.
for_window [app_id="xdg-desktop-portal-gtk"] floating enable, move position center

# The About fastfetch layout needs more columns than the standard float.
for_window [app_id="^org\.omarchy\.about$"] floating enable, resize set 920 480, move position center

# Calculator.
for_window [app_id="^omacalc$"] floating enable, move position center
for_window [class="^omacalc$"] floating enable, move position center

# Fullscreen screensaver.
for_window [app_id="^org\.omarchy\.screensaver$"] fullscreen enable

# Picture-in-picture overlays: float, pin, park in the top-right corner
# (positions computed for the fixed 1280x800 panel; sway cannot do the
# monitor-relative arithmetic Hyprland used).
for_window [title="Picture.?in.?[Pp]icture"] floating enable, sticky enable, border none, resize set 600 338, move position 640 32

# Any fullscreen window inhibits idle (translation of the idle_inhibit rules).
for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"] inhibit_idle fullscreen

# Preinstalled-app rules (steam, 1password, resolve, telegram, webcam
# overlay, ...) are dropped with the Lite scope: no preinstalled apps.

