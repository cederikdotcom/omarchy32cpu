bindsym Ctrl+Alt+Delete exec omarchy-hyprland-window-close-all

bindsym $mod+j layout toggle split
# no sway equivalent: pseudotiled window (SUPER+P)
bindsym $mod+t floating toggle
bindsym $mod+f fullscreen
bindsym $mod+Ctrl+f exec omarchy-hyprland-window-tiled-fullscreen-toggle
# no sway equivalent: maximize without covering the bar (SUPER+ALT+F full width)
bindsym $mod+o floating enable; sticky enable
bindsym $mod+Alt+Home exec omarchy-hyprland-window-width save
bindsym $mod+Home exec omarchy-hyprland-window-width restore
