bindsym $mod+Shift+Alt+b exec omarchy-launch-browser --private
bindsym $mod+Shift+n exec omarchy-launch-editor

# The preinstalled app/webapp bindings (tmux, spotify, chatgpt, ...) are
# dropped with the Lite scope: no preinstalled applications.

### Bindings: tiling (from default/hypr/bindings/tiling.lua) ###################

