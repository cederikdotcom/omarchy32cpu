# Maintainer: Omarchy32 CPU project

pkgname=dconf
pkgver=0.49.0
pkgrel=1.1
pkgdesc="Configuration database system"
arch=(i686 pentium4)
url="https://gitlab.gnome.org/GNOME/dconf"
license=(LGPL-2.1-or-later)
depends=(bash glib2 glibc)
makedepends=(dbus meson)
provides=(libdconf.so)
install=dconf.install
source=(
  "https://download.gnome.org/sources/dconf/0.49/dconf-$pkgver.tar.xz"
  dconf-update.hook
  dconf-update.script
)
sha256sums=(
  '16a47e49a58156dbb96578e1708325299e4c19eea9be128d5bd12fd0963d6c36'
  '8d02176ff001a13d15a7ac087edd2502725494668933fa2c6e6f9cb21ae24e6b'
  '330142605370f82f4229e8a94b245f911407eb629b50f1497f415c70164a90ec'
)
options=(!debug)

build() {
  local meson_options=(
    -D bash_completion=false
    -D gtk_doc=false
    -D man=false
    -D vapi=false
  )
  arch-meson "$pkgname-$pkgver" build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 dconf-update.hook -t "$pkgdir/usr/share/libalpm/hooks"
  install -D dconf-update.script "$pkgdir/usr/share/libalpm/scripts/dconf-update"
  install -Dm644 /dev/null "$pkgdir/etc/dconf/db/.placeholder"
}
